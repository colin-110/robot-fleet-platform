# ── Backend API ──────────────────────────────────────────────────────
# Leave empty to use relative URLs (same-origin), or set an absolute URL
# for cross-origin setups (e.g. backend on a different port/host).
VITE_API_BASE_URL=

# No API key here, deliberately. Vite inlines build-time variables into the
# bundle, so a key set here would be readable by anyone who opens devtools.
# The dashboard requests a short-lived console ticket at runtime instead
# (POST /api/v1/auth/ticket). See backend/app/tickets.py.
