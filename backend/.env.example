# Copy this file to `.env` and fill in real values. `.env` is gitignored -
# never commit real secrets. Rotate any credential that has ever been committed.

# ─── PostgreSQL (used by the db container and the backend) ──────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=robotfleet

# Full connection string (must match the POSTGRES_* values above).
# Example: postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=postgresql://postgres:change-me-strong-password@db:5432/robotfleet

# ─── Redis ──────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── App secrets ────────────────────────────────────────────────────
# Master key, required on the X-API-Key header for telemetry ingest and for
# robot-facing command polling. It never reaches the browser: the dashboard
# requests a short-lived console ticket instead (see backend/app/tickets.py),
# and this key is what those tickets are signed with - so rotating it also
# revokes every ticket already issued.
# Required - the app refuses to start without it. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
TELEMETRY_API_KEY=change-me-random-api-key

# Lifetime of a browser console ticket, in seconds.
TICKET_TTL_SECONDS=300

# ─── Operator authentication ────────────────────────────────────────
# "open"     - no accounts; the console is public. What the hosted demo runs,
#              because a login wall on a portfolio deployment means nobody
#              ever sees it, and the data behind it is synthetic.
# "required" - every console action needs a JWT from /api/v1/auth/login.
# Leave unset and production defaults to "required".
AUTH_MODE=open

# Access-token signing key. Derived from TELEMETRY_API_KEY when unset, so
# there is no second secret to rotate - and rotating that key invalidates
# every outstanding token. Must be 32+ chars if you do set it in production.
# JWT_SECRET=
JWT_TTL_SECONDS=3600

# Creates the first admin account at startup, but only while the users table
# is empty - restarting cannot resurrect a deleted admin or reset a password.
# Required to get into a fresh AUTH_MODE=required deployment.
# BOOTSTRAP_ADMIN_USERNAME=admin
# BOOTSTRAP_ADMIN_PASSWORD=

# ─── Application ────────────────────────────────────────────────────
# Environment: development | staging | production
# production additionally rejects CORS_ORIGINS=* and API keys under 16 chars.
APP_ENV=development

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Log output format: text | json. Unset means text in development and json in
# production. Every line carries the request id, so an X-Request-ID handed to a
# caller can be found in the logs.
# LOG_FORMAT=

# One structured line per HTTP request (method, path, status, duration_ms).
# Uvicorn's own access log is off in production, so this is the only record
# that a request happened at all.
ACCESS_LOG=true

# ─── CORS ───────────────────────────────────────────────────────────
# Comma-separated allowed origins. "*" is development-only, and credentials are
# automatically disabled when set (the spec forbids wildcard + credentials).
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Rate Limiting ──────────────────────────────────────────────────
# Max telemetry POSTs per client per minute
RATE_LIMIT_PER_MINUTE=120

# Number of reverse proxies in front of the app. Behind nginx + CloudFront this
# is 2. Leave 0 for direct exposure. If this is wrong the rate limiter either
# buckets the whole fleet under the proxy IP (too low) or trusts a
# client-supplied X-Forwarded-For (too high).
TRUSTED_PROXY_COUNT=0

# ─── Fleet state ────────────────────────────────────────────────────
# Seconds of silence before a robot is reported OFFLINE.
OFFLINE_AFTER_SECONDS=60

# How far back the fleet-status query scans for telemetry. Robots with no
# reading in this window still appear (sourced from the robot roster and shown
# OFFLINE) rather than disappearing from the fleet.
FLEET_WINDOW_MINUTES=15


# ─── Ingest ─────────────────────────────────────────────────────────
# Devices may report their own measurement time, which is what makes
# store-and-forward possible. A reading dated more than this many seconds in
# the future is clamped to server time, so a wrong device clock cannot poison
# time-bucketed analytics.
MAX_CLOCK_SKEW_SECONDS=300

# Entries kept in the Redis streams used for live WebSocket fan-out.
TELEMETRY_STREAM_MAXLEN=1000

# ─── Access control ─────────────────────────────────────────────────
# Whether read-only endpoints (fleet status, analytics, events) require an API
# key. Defaults false so the public demo works without shipping a key to every
# browser. Set true for any deployment with real fleet data.
REQUIRE_AUTH_FOR_READS=false

# ─── Device keys ────────────────────────────────────────────────────
# Each robot can authenticate with its own key (POST /api/v1/robots/{id}/key).
# Set ALLOW_SHARED_INGEST_KEY=false once every robot has its own key, so the
# master key no longer works for telemetry, events or command polling.
ALLOW_SHARED_INGEST_KEY=true
