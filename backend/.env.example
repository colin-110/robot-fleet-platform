# Copy this file to `.env` and fill in real values. `.env` is gitignored —
# never commit real secrets. Rotate any credential that has ever been committed.

# ─── PostgreSQL (used by the db container and the backend) ──────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=robotfleet

# Full connection string (must match the POSTGRES_* values above).
# Example: postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=postgresql://postgres:change-me-strong-password@db:5432/robotfleet

# ─── Redis ──────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── App secrets ────────────────────────────────────────────────────
# Shared key required on the X-API-Key header for telemetry/command endpoints.
# Required — the app refuses to start without it. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
TELEMETRY_API_KEY=change-me-random-api-key

# ─── Application ────────────────────────────────────────────────────
# Environment: development | staging | production
# production additionally rejects CORS_ORIGINS=* and API keys under 16 chars.
APP_ENV=development

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ─── CORS ───────────────────────────────────────────────────────────
# Comma-separated allowed origins. "*" is development-only, and credentials are
# automatically disabled when set (the spec forbids wildcard + credentials).
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Rate Limiting ──────────────────────────────────────────────────
# Max telemetry POSTs per client per minute
RATE_LIMIT_PER_MINUTE=120

# Number of reverse proxies in front of the app. Behind nginx + CloudFront this
# is 2. Leave 0 for direct exposure. If this is wrong the rate limiter either
# buckets the whole fleet under the proxy IP (too low) or trusts a
# client-supplied X-Forwarded-For (too high).
TRUSTED_PROXY_COUNT=0

# ─── Fleet state ────────────────────────────────────────────────────
# Seconds of silence before a robot is reported OFFLINE.
OFFLINE_AFTER_SECONDS=60

# How far back the fleet-status query scans for telemetry. Robots with no
# reading in this window still appear (sourced from the robot roster and shown
# OFFLINE) rather than disappearing from the fleet.
FLEET_WINDOW_MINUTES=15

# Rows of history per robot used for status and battery drain-rate estimation.
FLEET_HISTORY_PER_ROBOT=30

# ─── Ingest ─────────────────────────────────────────────────────────
# Devices may report their own measurement time, which is what makes
# store-and-forward possible. A reading dated more than this many seconds in
# the future is clamped to server time, so a wrong device clock cannot poison
# time-bucketed analytics.
MAX_CLOCK_SKEW_SECONDS=300

# Max entries retained in the telemetry Redis Stream. Redis trims the oldest
# beyond this — including entries the worker has not yet acknowledged — so this
# is catch-up headroom, not an unbounded durable log. Watch the
# telemetry_stream_length and telemetry_stream_pending metrics.
TELEMETRY_STREAM_MAXLEN=100000

# ─── Access control ─────────────────────────────────────────────────
# Whether read-only endpoints (fleet status, analytics, events) require an API
# key. Defaults false so the public demo works without shipping a key to every
# browser. Set true for any deployment with real fleet data.
REQUIRE_AUTH_FOR_READS=false

# ─── Observability ──────────────────────────────────────────────────
# Required when running more than one uvicorn worker: prometheus_client keeps
# counters in process memory, so without this /metrics reports only whichever
# worker served the scrape.
PROMETHEUS_MULTIPROC_DIR=/tmp/prometheus

# ─── Optimization flags ─────────────────────────────────────────────
# All default to true. scripts/benchmark_matrix.py flips one at a time to
# measure that optimization's individual contribution.

# Ingest via Redis Stream (XADD, worker persists) vs synchronous INSERT.
OPT_REDIS_BUFFER=true

# Redis read-through cache on fleet status + analytics vs recompute per request.
OPT_READ_CACHE=true

# orjson response serialization vs stdlib json.
OPT_ORJSON=true

# Pure ASGI middleware vs Starlette BaseHTTPMiddleware.
OPT_ASGI_MIDDLEWARE=true

# Bounded per-client WebSocket queues vs a send task per client per message.
OPT_BOUNDED_FANOUT=true

# Worker persists a batch as one multi-row INSERT vs one INSERT per row.
OPT_BATCH_INSERT=true
